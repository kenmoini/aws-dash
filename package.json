{
  "name": "aws-dash",
  "version": "0.1.0",
  "private": true,
  "description": "AWS workload identity demo dashboard for EKS, Kubernetes and OpenShift (ZTWIM)",
  "type": "module",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "healthcheck": "node dist/cli.js --healthcheck",
    "kustomize:check": "scripts/kustomize-check.sh",
    "placeholders:check": "scripts/check-placeholders.sh"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1141.0",
    "@aws-sdk/client-ecr": "3.1141.0",
    "@aws-sdk/client-eks": "3.1141.0",
    "@aws-sdk/client-iam": "3.1141.0",
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/client-sts": "3.1141.0",
    "@aws-sdk/credential-providers": "3.1141.0",
    "@aws-sdk/types": "3.974.6",
    "@fastify/formbody": "9.0.0",
    "@fastify/static": "10.1.5",
    "@smithy/property-provider": "4.5.2",
    "eta": "4.6.0",
    "fastify": "5.12.5",
    "pino": "10.3.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "4.1.0",
    "@types/node": "24.19.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
