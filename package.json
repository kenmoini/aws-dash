{
  "name": "aws-dash",
  "version": "0.1.0",
  "private": true,
  "description": "AWS workload identity demo dashboard for EKS, Kubernetes and OpenShift (ZTWIM)",
  "type": "module",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "healthcheck": "node dist/cli.js --healthcheck",
    "kustomize:check": "scripts/kustomize-check.sh"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.0",
    "@fastify/static": "10.1.5",
    "eta": "4.6.0",
    "fastify": "5.12.5",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
