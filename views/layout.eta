<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= it.title %> · aws-dash</title>
  <link rel="stylesheet" href="/public/css/site.css" />
  <script src="/public/js/htmx.min.js"></script>
  <script>
    document.addEventListener("htmx:responseError", (e) => {
      const t = e.detail.xhr;
      let msg = t.statusText;
      try { msg = JSON.parse(t.responseText).detail ?? msg; } catch {}
      const box = document.getElementById("control-error");
      if (box) { box.textContent = t.status + ": " + msg; box.hidden = false; }
    });
  </script>
</head>
<body>
  <header class="topbar">
    <span class="brand">aws-dash</span>
    <nav>
      <a href="/" class="<%= it.nav === "runtime" ? "active" : "" %>">Runtime</a>
      <a href="/aws" class="<%= it.nav === "aws" ? "active" : "" %>">AWS</a>
      <a href="/identity" class="<%= it.nav === "identity" ? "active" : "" %>">Identity</a>
    </nav>
    <span class="version">v<%= it.version %></span>
  </header>
  <main>
<%~ it.body %>
  </main>
</body>
</html>
